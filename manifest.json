{
  "manifest_version": 2,
  "name": "FuzzyTabs",
  "version": "1.2.1",
  "description": "Fuzzy-search through opened tabs",
  "browser_specific_settings": {
    "gecko": {
      "id": "fuzzytabs@example.com"
    }
  },
  "icons": {
    "48": "icons/ic_search.svg"
  },
  "browser_action": {
    "default_title": "FuzzyTabs",
    "default_icon": "icons/ic_search.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "app.html",
    "app.js",
    "app.css",
    "microfuzz.bundle.js",
    "options.html",
    "options.js",
    "icons/ic_search.svg"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Shift+Alt+I",
        "mac": "Shift+Command+I"
      },
      "description": "Open FuzzyTabs"
    }
  }
}